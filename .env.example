# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sprintiq

# Local development: postgresql://postgres:postgres@localhost:5432/sprintiq?schema=public
# Docker Compose: postgresql://postgres:postgres@postgres:5432/sprintiq?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sprintiq?schema=public

# ==========================================
# Cache & Session Store (Redis)
# ==========================================
# Local development: redis://127.0.0.1:6379
# Docker Compose: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# ==========================================
# Authentication & Security (JWT)
# ==========================================
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=604800

# ==========================================
# Frontend Configuration (Optional)
# ==========================================
# VITE_API_URL=http://localhost:3000
