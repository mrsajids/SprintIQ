            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "    pm.collectionVariables.set('taskId', json.id);",
              "}",
              "pm.test('Status code is 201 Created', function () {",
              "    pm.expect(pm.response.code).to.eql(201);",
              "});",
              "pm.test('Default status is TODO', function () {",
              "    pm.expect(json.status).to.eql('TODO');",
              "});",
              "pm.test('Has required fields', function () {",
              "    pm.expect(json.title).to.eql('Create Kanban board');",
              "    pm.expect(json.projectId).to.eql(pm.collectionVariables.get('projectId'));",
              "    pm.expect(json.createdById).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
