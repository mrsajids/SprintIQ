    {
      "name": "04 - User A - Get Project Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status code is 200 OK', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "pm.test('All four status columns exist', function () {",
              "    pm.expect(json.TODO).to.be.an('array');",
              "    pm.expect(json.IN_PROGRESS).to.be.an('array');",
              "    pm.expect(json.IN_REVIEW).to.be.an('array');",
              "    pm.expect(json.DONE).to.be.an('array');",
              "});",
              "pm.test('Tasks are in TODO column', function () {",
              "    pm.expect(json.TODO.length).to.be.at.least(3);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userAToken}}" }
