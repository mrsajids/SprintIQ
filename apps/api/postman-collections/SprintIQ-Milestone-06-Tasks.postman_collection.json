              "});",
              "pm.test('Task 1 is in IN_PROGRESS column', function () {",
              "    const inProgressIds = json.IN_PROGRESS.map(t => t.id);",
              "    pm.expect(inProgressIds).to.include(pm.collectionVariables.get('taskId'));",
              "});",
              "pm.test('Task 1 is NOT in TODO column', function () {",
              "    const todoIds = json.TODO.map(t => t.id);",
              "    pm.expect(todoIds).to.not.include(pm.collectionVariables.get('taskId'));",
              "});"
            ],
            "type": "text/javascript"
