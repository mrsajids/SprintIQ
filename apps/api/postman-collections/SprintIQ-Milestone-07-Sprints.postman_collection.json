  "item": [
    {
      "name": "00 - Setup: Login User A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.accessToken) {",
              "    pm.collectionVariables.set('userAToken', json.accessToken);",
              "}",
              "pm.test('Login User A successful', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"{{userAPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "01 - User A - Create Sprint (PLANNED)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "    pm.collectionVariables.set('sprintAId', json.id);",
              "}",
              "pm.test('Status code is 201 Created', function () {",
              "    pm.expect(pm.response.code).to.eql(201);",
              "});",
              "pm.test('Default status is PLANNED', function () {",
              "    pm.expect(json.status).to.eql('PLANNED');",
              "});",
              "pm.test('Belongs to Project A', function () {",
              "    pm.expect(json.projectId).to.eql(pm.collectionVariables.get('projectAId'));",
              "    pm.expect(json.name).to.eql('Sprint 1');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userAToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sprint 1\",\n  \"goal\": \"Complete core platform\",\n  \"startDate\": \"2026-09-07T00:00:00.000Z\",\n  \"endDate\": \"2026-09-20T23:59:59.999Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectAId}}/sprints",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectAId}}", "sprints"]
        }
      }
    },
    {
      "name": "02 - User A - Update Sprint to ACTIVE, Name, and Goal",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status code is 200 OK', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "pm.test('Sprint fields updated', function () {",
              "    pm.expect(json.status).to.eql('ACTIVE');",
              "    pm.expect(json.name).to.eql('Sprint 1 — Core Platform');",
              "    pm.expect(json.goal).to.eql('Finish core platform APIs');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userAToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sprint 1 — Core Platform\",\n  \"goal\": \"Finish core platform APIs\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sprints/{{sprintAId}}",
          "host": ["{{baseUrl}}"],
          "path": ["sprints", "{{sprintAId}}"]
        }
      }
    },
    {
      "name": "03 - User A - Assign Task to Sprint",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status code is 200 OK', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "pm.test('Task assigned to Sprint A', function () {",
              "    pm.expect(json.sprintId).to.eql(pm.collectionVariables.get('sprintAId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userAToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sprintId\": \"{{sprintAId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskAId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskAId}}"]
        }
      }
    },
    {
      "name": "04 - User A - Remove Task from Sprint",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status code is 200 OK', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "pm.test('sprintId is now null', function () {",
              "    pm.expect(json.sprintId).to.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
