        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskAId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskAId}}"]
        }
      }
    },
    {
      "name": "05 - User A - Reject Cross-Project Sprint Assignment (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "});",
              "pm.test('Cross-project error message', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql('Sprint does not belong to the same project as the task');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
